{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeShell",
  "version": "0.1.19",
  "identifier": "com.vibeshell.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build && node scripts/build-vshell-sidecar.js",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VibeShell",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/vshell"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "nsis-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "wix-path-fragment.wxs"
        ],
        "componentGroupRefs": [
          "VshellPathEnvGroup"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RDA2NzVDRUVDRTgwREYKUldUZmdNN3VYR2ZRQk9VS0RhNFJHQk43MENreFloWVBwZlIzS3Y0WjJsZmFDdkkwNk56K1RoSk4K",
      "endpoints": [
        "https://github.com/veithly/vibeshell/releases/latest/download/latest.json"
      ]
    }
  }
}
