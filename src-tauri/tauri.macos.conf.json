{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "VibeShell",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "dragDropEnabled": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "active",
          "radius": 14
        }
      }
    ]
  }
}
