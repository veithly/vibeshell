# ============================================
# Tauri bundle artifacts
# ============================================
src-tauri/target/
# Tauri regenerates ACL schemas, while mobile platform projects are source artifacts.
src-tauri/gen/schemas/
# Legacy standalone CLI build artifacts are not bundled with the desktop app.
src-tauri/binaries/vshell*
!src-tauri/binaries/.gitkeep

# ============================================
